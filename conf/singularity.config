// ========== SINGULARITY ENGINE SETTINGS ==========
// Container engine only. Per-process resources/retries now live in
// conf/base.config (loaded unconditionally) so they apply to every engine and
// cluster, not just `-profile singularity`.
singularity {
    enabled      = true
    autoMounts   = true
    envWhitelist = 'CUDA_VISIBLE_DEVICES,SINGULARITYENV_CUDA_VISIBLE_DEVICES'
    // note: will need to override this if scratch_dir is false (cannot use a closure here)
    runOptions   = "--bind ${launchDir}:/launchDir:ro --bind ${params.scratch_dir}"
}
