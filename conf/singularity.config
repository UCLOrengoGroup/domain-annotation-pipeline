// ========== SINGULARITY ENGINE SETTINGS ==========
singularity {
    enabled      = true
    autoMounts   = true
    envWhitelist = 'CUDA_VISIBLE_DEVICES,SINGULARITYENV_CUDA_VISIBLE_DEVICES'
}


// ========== HPC PER-PROCESS RESOURCES ==========
// HPC-specific resource ladders, retries and local pins. HPC runs use
// singularity, so these live here rather than base.config (which only holds the
// universal floor). Local/CI overrides live in docker.config.
process {

    // ---------- foldseek ----------
    withName: 'foldseek_create_db|foldseek_run_convertalis' {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 15.GB : 25.GB }
        cpus          = 1
    }

    withName: foldseek_run_foldseek {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 31.GB : task.attempt == 2 ? 45.GB : 63.GB }
        cpus          = 2 //must keep cpus to a sensible number to prevent run_foldseek failure
    }

    withName: foldseek_process_results {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 1.GB : task.attempt == 2 ? 2.GB : 8.GB }
    }

    // ---------- extraction / chopping ----------
    withName: chop_pdb_from_zip {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    withName: filter_pdb_from_zip {
        executor      = 'local'
        errorStrategy = 'retry'
        maxRetries    = 3
        scratch       = false
    }

    // ---------- uniprot / collect ----------
    withName: get_uniprot_data {
        maxForks      = 2
        errorStrategy = 'retry'
        maxRetries    = 5
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    withName: collect_results {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 8.GB : 12.GB }
    }

    // ---------- AFDB (bcif) path ----------
    withName: normalise_af_ids {
        executor  = 'local'
        container = null
        scratch   = false
    }

    withName: 'download_bcif_from_afdb' {
        time             = '23h'
        memory           = 7.GB
        maxForks         = 50
        ext.scratchSpace = 20.GB
    }

    withName: 'prepare_pdb_from_af_bcif' {
        time             = '23h'
        memory           = { task.attempt == 1 ? 23.GB : 31.GB }
        ext.scratchSpace = 20.GB
        maxRetries       = 3
    }

    withName: transform_consensus {
        executor      = 'local'
        scratch       = false
    }

    withName: filter_pdb_from_zip {
        executor      = 'local'
        errorStrategy = 'retry'
        maxRetries    = 3
        scratch       = false
    }
    // These need more memory than askey can provide so must move to sge_low. scratch=false will hopefully prevent output used by downstream processes getting lost on the NODE
    withName: 'create_input_from_zip|chunk_by_zip|heavy_chunk_by_zip|light_chunk_consensus_by_zip|run_plddt|join_plddt_md5|benchmark_compare_results' {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
        scratch       = false
    }

    // ---------- TED-TOOLS ------------
    withName: 'run_ted_merizo_unidoc|run_ted_chainsaw' {
        errorStrategy = 'retry'
        maxRetries    = 4
        memory        = { task.attempt == 1 ? 32.GB : task.attempt == 2 ? 48.GB : 63.GB }
        time          = '12h'    // used for documentation; h_rt fixed in cluster label
    }

    withName: run_ted_consensus {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 8.GB : 12.GB }
        time          = '3h'
    }

    withName: run_domain_quality {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 31.GB : task.attempt == 2 ? 45.GB : 63.GB }
    }

    // ---------- cath-af-cli ----------
    withName: run_stride {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 1.GB : task.attempt == 2 ? 2.GB : 8.GB }
        time          = '12h'
    }

    withName: run_measure_globularity {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
        time          = '12h'
    }

    // ---------- misc lightweight ----------
    withName: transform_consensus {
        executor      = 'local'
        scratch       = false
    }

    withName: create_md5 {
        executor      = 'local'
        scratch       = false
    }
}
