
params {
    // ted-tools consensus scripts, addressed at their in-container paths so a rebuilt
    // image (which git-clones ted-tools) is the source of truth for their version.
    prefilter_script = "python3 /app/ted-tools/ted_consensus_1.0/scripts/filter_domains.py"
    getconsensus_script = "python3 /app/ted-tools/ted_consensus_1.0/scripts/get_consensus.py"
    postfilter_script = "python3 /app/ted-tools/ted_consensus_1.0/scripts/filter_domains_consensus.py"
    // globularity_script (cath-af-cli measure-globularity) is a PATH command and is set
    // once in nextflow.config — no container override needed.
    // Note: all pipeline scripts (fetch_uniprot_data.py, chop_pdbs.py, combine_results.py,
    // transform_consensus.py, fetch_avg_plDDT.py, create_stride_summary.py, combine_results_final.py,
    // chunk_by_zip.py, chunk_consensus_by_zip.py, create_input_from_zip_script.py, format_fs_output.py,
    // etc.) now live in bin/ and are invoked by bare name via ${projectDir}/bin on PATH — not set here.
    foldseek_exec = '/usr/local/bin/entrypoint'
    domain_quality_script_setup = """
    . /app/ted-tools/ted_consensus_1.0/ted_consensus/bin/activate
    """
    domain_quality_script = """python3 /app/ted-tools/ted_consensus_1.0/scripts/run_domain_quality_checks.py"""

    // run_segmentation_script = "cd /app/ted-tools/ted_consensus_1.0/ && bash run_segmentation.sh"

    // HACK: the script Run_UniDoc_from_scratch_structure_afdb.py expects:
    //   - to run executable ./stride
    //   - to write to temp file ./pdb_ss
    // this is not possible in a read-only container environment like singularity
    // so we do a shallow copy of the important parts into the working directory
    run_segmentation_script_setup = """
    cp /app/ted-tools/ted_consensus_1.0/run_segmentation.sh .
    ln -s /app/ted-tools/ted_consensus_1.0/ted_consensus .
    cp -a /app/ted-tools/ted_consensus_1.0/scripts ./scripts
    mkdir -p ./programs
    ln -s /app/ted-tools/ted_consensus_1.0/programs/merizo ./programs/merizo
    ln -s /app/ted-tools/ted_consensus_1.0/programs/chainsaw ./programs/chainsaw
    mkdir -p ./programs/unidoc
    cp /app/ted-tools/ted_consensus_1.0/programs/unidoc/Run_UniDoc_from_scratch_structure_afdb.py ./programs/unidoc/
    mkdir -p ./programs/unidoc/bin
    cp /app/ted-tools/ted_consensus_1.0/programs/unidoc/bin/UniDoc_struct ./programs/unidoc/bin/UniDoc_struct
    cp /app/ted-tools/ted_consensus_1.0/programs/unidoc/bin/stride ./programs/unidoc/bin/stride
    . ted_consensus/bin/activate
    """
    run_segmentation_script = "bash run_segmentation.sh"
}

process {
    // Only set a default container for processes that do not declare one inline
    withName: 'collect_results|collect_taxonomy|join_plddt_md5|collect_chopping_names|fetch_foldseek_assets|foldseek_filter_domain_agreement|files_from_zip' {
        container = "ghcr.io/uclorengogroup/domain-annotation-pipeline-script:${params.container_tag_name}"
    }
}
