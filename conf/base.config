/*
 * conf/base.config
 * ---------------------------------------------------------------------------
 * Environment-AGNOSTIC defaults: per-process resources, retry policy and
 * correctness constraints. Loaded UNCONDITIONALLY from nextflow.config
 * (outside the profiles block), so it applies to every run regardless of
 * container engine or cluster..
 * ---------------------------------------------------------------------------
 */

process {

    // ---------- Global defaults: every process gets a fixed baseline ----------
    // Any module without a more specific withName block below inherits these, so
    // nothing ever falls back to Nextflow's implicit 1-CPU / unset-memory default.
    // memory scales with task.attempt so a retry gets more headroom. Walltime is
    // deliberately NOT set here — it is cluster-specific and handled by each
    // cluster config's clusterOptions fallback (and per-process `time` below).
    cpus          = 1
    memory        = { 2.GB * task.attempt }
    errorStrategy = { task.exitStatus in ((130..145) + [104]) ? 'retry' : 'finish' }
    maxRetries    = 2
    cache         = 'lenient'

    // ---------- CORRECTNESS CONSTRAINT (do not remove) ----------
    // chunk_ids_by_zip (aliased as chunk_by_zip / heavy_chunk_by_zip) and
    // light_chunk_consensus_by_zip write their real output files into a subdir
    // and hand the ABSOLUTE path downstream via a mapping .tsv (consumed with
    // file(col)). Node-local scratch deletes those files when the scratch dir is
    // cleaned up, which breaks filter_pdb_from_zip / chop_pdb_from_zip with
    // "cp: cannot stat .../chunks/...". withName beats withLabel, so this pins
    // them to the shared work dir even if a cluster enables scratch on the
    // sge_low label. All alias spellings are listed so it matches however
    // Nextflow resolves the include-as names.
    withName: 'chunk_ids_by_zip|chunk_by_zip|heavy_chunk_by_zip|light_chunk_consensus_by_zip' {
        scratch = false
    }

    // ---------- foldseek ----------
    withName: 'foldseek_create_db|foldseek_run_convertalis' {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 15.GB : 25.GB }
        cpus          = 1
    }

    withName: foldseek_run_foldseek {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 15.GB : task.attempt == 2 ? 31.GB : 45.GB }
        cpus          = 2 //must keep cpus to a sensible number to prevent run_foldseek failure
    }

    withName: foldseek_process_results {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 1.GB : task.attempt == 2 ? 2.GB : 8.GB }
    }

    // ---------- extraction / chopping ----------
    withName: chop_pdb_from_zip {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    withName: filter_pdb_from_zip {
        executor      = 'local'
        errorStrategy = 'retry'
        maxRetries    = 3
        scratch       = false
    }

    // ---------- uniprot / collect ----------
    withName: get_uniprot_data {
        maxForks      = 2
        errorStrategy = 'retry'
        maxRetries    = 5
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
    }

    withName: collect_results {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 8.GB : 12.GB }
    }

    // ---------- AFDB (bcif) path ----------
    withName: normalise_af_ids {
        executor  = 'local'
        container = null
        scratch   = false
    }

    withName: 'download_bcif_from_afdb' {
        time             = '23h'
        memory           = 7.GB
        maxForks         = 50
        ext.scratchSpace = 20.GB
    }

    withName: 'prepare_pdb_from_af_bcif' {
        time             = '23h'
        memory           = { task.attempt == 1 ? 23.GB : 31.GB }
        ext.scratchSpace = 20.GB
        maxRetries       = 3
    }

    // ---------- ted-tools ----------
    withName: 'run_ted_merizo_unidoc|run_ted_chainsaw' {
        errorStrategy = 'retry'
        maxRetries    = 4
        memory        = { task.attempt == 1 ? 32.GB : task.attempt == 2 ? 48.GB : 63.GB }
        time          = '12h'    // used for documentation; h_rt fixed in cluster label
    }

    withName: run_ted_consensus {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 4.GB : task.attempt == 2 ? 8.GB : 12.GB }
        time          = '3h'
    }

    withName: run_domain_quality {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 31.GB : task.attempt == 2 ? 45.GB : 63.GB }
    }

    // ---------- cath-af-cli ----------
    withName: run_stride {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 1.GB : task.attempt == 2 ? 2.GB : 8.GB }
        time          = '12h'
    }

    withName: run_measure_globularity {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { task.attempt == 1 ? 2.GB : task.attempt == 2 ? 4.GB : 8.GB }
        time          = '12h'
    }

    // ---------- misc lightweight ----------
    withName: transform_consensus {
        executor      = 'local'
        scratch       = false
    }

    withName: create_md5 {
        executor      = 'local'
        scratch       = false
    }
}
