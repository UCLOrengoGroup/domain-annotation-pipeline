/*
 * conf/base.config
 * ---------------------------------------------------------------------------
 * Universal, environment-agnostic minimums: a basic resource floor so every
 * module has a fixed baseline, plus correctness constraints. Loaded
 * UNCONDITIONALLY from nextflow.config.
 *
 * HPC-specific per-process resource ladders and retry policy are NOT here —
 * they live in conf/singularity.config (HPC runs use singularity). Local/CI
 * overrides live in conf/docker.config.
 * ---------------------------------------------------------------------------
 */

process {

    cache = 'lenient'

    // Basic floor: every module gets these unless a profile raises them, so
    // nothing falls back to Nextflow's implicit unset-memory default.
    cpus   = 1
    memory = { 4.GB * task.attempt }

    // ---------- CORRECTNESS CONSTRAINT (do not remove) ----------
    // chunk_ids_by_zip (aliased chunk_by_zip / heavy_chunk_by_zip) and
    // light_chunk_consensus_by_zip write outputs into a subdir and pass absolute
    // paths downstream via a mapping .tsv, which node-local scratch deletes ->
    // filter_pdb_from_zip / chop_pdb_from_zip fail with "cp: cannot stat".
    // withName beats withLabel, so this pins them to the shared work dir even if
    // a cluster enables scratch on the sge_low label. Kept here (always-on) as a
    // safety net, though it only matters where scratch is used (HPC).
    withName: 'chunk_ids_by_zip|chunk_by_zip|heavy_chunk_by_zip|light_chunk_consensus_by_zip' {
        scratch = false
    }
}
