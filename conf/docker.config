docker {
    enabled = true
    runOptions = "--platform linux/amd64 -v ${launchDir}:/launchDir:ro"
}

process {

    withName: run_ted_chainsaw {
        memory = { params.project_name == 'git_actions_test' ? 14.GB : 16.GB }
        cpus = 2
    }
    
    withName: run_ted_consensus {
        memory = { params.project_name == 'git_actions_test' ? 14.GB : 16.GB }
        cpus = 2
    }
    
    withName: run_ted_merizo_unidoc {
        memory = { params.project_name == 'git_actions_test' ? 14.GB : 16.GB }
        cpus = 2
    }

    withName: 'foldseek_create_db|foldseek_run_foldseek|foldseek_run_convertalis' {
        memory = { params.project_name == 'git_actions_test' ? 14.GB : 16.GB }
    }

    // Cap for docker/CI: base.config now requests 31 GB (cluster sizing) for
    // this process, which a CI runner cannot satisfy. Keep it in line with the
    // other CI overrides above.
    withName: run_domain_quality {
        memory = { params.project_name == 'git_actions_test' ? 14.GB : 16.GB }
    }
}
