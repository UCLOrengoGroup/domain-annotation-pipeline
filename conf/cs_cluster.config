params {
    config_profile_description = 'University College London CS cluster'
    config_profile_contact     = 'Chris Wyatt (c . wyatt AT ucl . ac . uk)'
    config_profile_url         = 'https://hpc.cs.ucl.ac.uk/'
}

// This config is adapted from nf-core configs to allow the user specific cpu gpu demands.

executor {
    name = 'sge'
}

singularity {
    enabled    = true
    autoMounts = true
    // Singularity image cache: honour NXF_SINGULARITY_CACHEDIR if set (e.g. a
    // shared /SAN location), otherwise default to the user's home.
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('HOME')}/.singularity/pull"
    runOptions = "-B ${System.getenv('HOME')},${System.getenv('PWD')}"
}

process {
    scratch  = false                       // run on shared /SAN — always correct, no vanishing paths
    executor = 'sge'
    beforeScript = "mkdir -p /scratch0/${System.getenv('USER')}/"
    scratch = "/scratch0/${System.getenv('USER')}/"
    penv     = { task.cpus > 1 ? 'smp' : null }

    // Default for any unlabelled SGE process. task.memory is always set
    // (base.config provides a global default), so no null-guard is needed.
    clusterOptions = {
        def mem = task.memory.mega as int
        def opts = "-S /bin/bash -l tmem=${mem}M,h_vmem=${mem}M"
        if (task.cpus > 1) opts += " -R y"
        return opts
    }

    // CPU jobs
    withLabel: sge_low {
        clusterOptions = {
            def mem = task.memory.mega as int
            def opts = "-S /bin/bash -l tmem=${mem}M,h_vmem=${mem}M"
            // foldseek requires AVX2
            if( task.process in ['foldseek_create_db','foldseek_run_foldseek','foldseek_run_convertalis'] ) {
                opts += " -l avx2=yes"
            }
            if (task.cpus > 2) opts += " -R y"
            return opts
        }
    }

    // GPU jobs
    withLabel: sge_gpu_high {
        containerOptions = '--nv --env CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES'  // GPU support in containers
        clusterOptions = {
            def mem = task.memory.mega as int
            def opts = "-S /bin/bash -l tmem=${mem}M,h_vmem=${mem}M -l gpu=true"
            if (task.cpus > 1) opts += " -R y"
            return opts
        }
    }
}
